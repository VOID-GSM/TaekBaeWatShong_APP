# Expo 는 EXPO_PUBLIC_ 접두사가 붙은 값만 클라이언트 번들에 주입한다.
# 비밀 값(API 키 등)은 절대 여기에 두지 말 것 — 번들에 그대로 박힌다.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_WS_URL=ws://localhost:8080/ws

# 빌드 variant: development | preview | production
APP_VARIANT=development

# Android 푸시(FCM)용 Firebase 설정 파일 경로 (선택). 파일은 커밋하지 않는다 — README 푸시 알림 절 참고.
# GOOGLE_SERVICES_JSON=./google-services.json
