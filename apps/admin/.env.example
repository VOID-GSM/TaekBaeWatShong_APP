# Expo 는 EXPO_PUBLIC_ 접두사가 붙은 값만 클라이언트 번들에 주입한다.
# 비밀 값(API 키 등)은 절대 여기에 두지 말 것 — 번들에 그대로 박힌다.
EXPO_PUBLIC_API_URL=http://localhost:8080
EXPO_PUBLIC_WS_URL=ws://localhost:8080/ws

# Google OAuth Client IDs (공개 식별자; client secret은 설정하지 마세요)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# 빌드 variant: development | preview | production
APP_VARIANT=development
