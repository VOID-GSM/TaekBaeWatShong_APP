{
  "name": "taekbaewatshong",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@taekbae/client",
    "dev:admin": "turbo run dev --filter=@taekbae/admin",
    "go:client": "pnpm --filter @taekbae/client run go",
    "go:admin": "pnpm --filter @taekbae/admin run go",
    "start": "turbo run start",
    "android": "turbo run android",
    "ios": "turbo run ios",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,yml,yaml}\"",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "clean": "turbo run clean && rimraf node_modules",
    "prepare": "husky",
    "eas": "eas",
    "eas:build:client": "pnpm --filter @taekbae/client exec eas build",
    "eas:build:admin": "pnpm --filter @taekbae/admin exec eas build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eas-cli": "^24.7.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.11.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
